HOST=https://deliveroojs.onrender.com
# Which agent to run: bubble or milktea
AGENT=bubble
# Tokens are per server. To get one, connect once by name with no token and
# read the 'token' event (npm run observe prints it).
TOKEN_BUBBLE=
TOKEN_MILKTEA=
# pddl (the default) calls the external planner when an intention starts; astar skips it.
MOVER=pddl

# Optional tuning overrides; leave unset for the defaults in src/config.js.
# REPLACE_MARGIN=1.2
# BLOCKED_TTL_MS=2000
# MAX_BLOCKED_MS=30000
# AGENT_TTL_MS=3000
# MAX_MOVE_RETRIES=3
# PDDL_TIMEOUT_MS=5000
# net_gain (the default) or baseline: how pickups are weighed against delivering.
# With net_gain, a goal is switched as soon as another earns at least MIN_NET_GAIN more points.
# OPTION_STRATEGY=net_gain
# MIN_NET_GAIN=1
# With net_gain, every option is charged for its time: points per second, or auto to learn it from the score.
# TIME_VALUE=auto
# With net_gain, a pickup gives way to delivering once delivering is worth more than this many points more.
# DELIVERY_PROTECTION=0
