{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.js",
    "test/**/*.js",
    "types/**/*.d.ts"
  ]
}
