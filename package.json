  "dependencies": {
    "@unitn-asa/deliveroo-js-sdk": "^1.3.10",
    "@unitn-asa/pddl-client": "^1.7.7",
    "dotenv": "^18.0.7",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
