HOST=https://deliveroojs.onrender.com
# Which agent to run: bubble or milktea
AGENT=bubble
# Tokens are per server. To get one, connect once by name with no token and
# read the 'token' event (npm run observe prints it).
TOKEN_BUBBLE=
TOKEN_MILKTEA=
MOVER=astar

# Optional tuning overrides; leave unset for the defaults in src/config.js.
# REPLACE_MARGIN=1.2
# BLOCKED_TTL_MS=2000
# MAX_BLOCKED_MS=30000
# AGENT_TTL_MS=3000
# MAX_MOVE_RETRIES=3
# PDDL_TIMEOUT_MS=5000
